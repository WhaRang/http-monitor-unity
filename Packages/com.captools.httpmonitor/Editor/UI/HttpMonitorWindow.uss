/* HTTP Monitor window. Layout colours resolve against the active Editor theme; status colours are
   fixed because they carry meaning (same hues as browser dev tools). */

.hm-root {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- toolbar */

.hm-toolbar {
    flex-shrink: 0;
}

.hm-toolbar-spacer {
    flex-grow: 1;
}

.hm-record-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 4px;
    margin-left: 2px;
    align-self: center;
    background-color: #d13438;
}

.hm-record-dot--paused {
    background-color: #8a8a8a;
}

/* ---------------------------------------------------------------- split */

.hm-split {
    flex-grow: 1;
}

.hm-list-pane {
    flex-grow: 1;
    min-width: 200px;
    min-height: 80px;
}

.hm-record-list {
    flex-grow: 1;
}

.hm-list {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- cells */

.hm-cell {
    padding-left: 4px;
    padding-right: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
    height: 100%;
}

.hm-cell-method {
    -unity-font-style: bold;
}

.hm-cell-status {
    -unity-text-align: middle-right;
}

.hm-cell-status--error {
    color: #f85149;
}

.hm-cell-right {
    -unity-text-align: middle-right;
}

.hm-cell-dot {
    align-items: center;
    justify-content: center;
    height: 100%;
}

.hm-cell-name {
    flex-direction: row;
    align-items: center;
}

.hm-cell-name-text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hm-source-badge {
    flex-shrink: 0;
    font-size: 9px;
    padding: 0 3px;
    margin-right: 5px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.6);
    color: rgba(128, 128, 128, 0.9);
    -unity-text-align: middle-center;
    min-width: 14px;
}

.hm-source-badge--manual {
    border-color: rgba(88, 166, 255, 0.8);
    color: rgb(88, 166, 255);
}

.hm-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    flex-shrink: 0;
    background-color: #8a8a8a;
}

.hm-status-dot--pending {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: #8a8a8a;
}

.hm-status-dot--2xx { background-color: #3fb950; }
.hm-status-dot--3xx { background-color: #58a6ff; }
.hm-status-dot--4xx { background-color: #e3a008; }
.hm-status-dot--5xx { background-color: #f85149; }
.hm-status-dot--failed { background-color: #f85149; }
.hm-status-dot--aborted { background-color: #8a8a8a; }

/* ---------------------------------------------------------------- jump to latest */

.hm-jump-latest {
    position: absolute;
    right: 20px;
    bottom: 8px;
    padding: 3px 10px;
    border-radius: 10px;
    opacity: 0.92;
}

/* ---------------------------------------------------------------- empty state */

.hm-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.hm-empty-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.hm-empty-text {
    opacity: 0.75;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 420px;
}

/* ---------------------------------------------------------------- detail */

.hm-detail-pane {
    flex-grow: 1;
    min-width: 200px;
    min-height: 80px;
    padding: 8px;
}

.hm-detail-placeholder {
    opacity: 0.6;
    -unity-text-align: middle-center;
    flex-grow: 1;
    justify-content: center;
}

.hm-detail-summary {
    white-space: normal;
}

/* ---------------------------------------------------------------- status bar */

.hm-statusbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 2px 8px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.25);
}

.hm-statusbar-text {
    opacity: 0.8;
}
