/* HTTP Monitor window. Colours resolve against the active Editor theme; status colours are fixed
   because they carry meaning (same hues as browser dev tools). */

.hm-root {
    flex-grow: 1;
}

.hm-toolbar {
    flex-shrink: 0;
}

.hm-toolbar-spacer {
    flex-grow: 1;
}

.hm-record-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 4px;
    margin-left: 2px;
    align-self: center;
    background-color: #d13438;
}

.hm-record-dot--paused {
    background-color: #8a8a8a;
}

.hm-split {
    flex-grow: 1;
}

.hm-list-pane {
    flex-grow: 1;
    min-width: 200px;
    min-height: 80px;
}

.hm-list {
    flex-grow: 1;
}

.hm-row {
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;
}

.hm-row-method {
    width: 48px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.hm-row-status {
    width: 40px;
    flex-shrink: 0;
    -unity-text-align: middle-right;
    margin-right: 8px;
}

.hm-row-url {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hm-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 6px;
    flex-shrink: 0;
    background-color: #8a8a8a;
}

.hm-status-dot--pending {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: #8a8a8a;
}

.hm-status-dot--2xx { background-color: #3fb950; }
.hm-status-dot--3xx { background-color: #58a6ff; }
.hm-status-dot--4xx { background-color: #e3a008; }
.hm-status-dot--5xx { background-color: #f85149; }
.hm-status-dot--failed { background-color: #f85149; }
.hm-status-dot--aborted { background-color: #8a8a8a; }

.hm-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.hm-empty-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.hm-empty-text {
    opacity: 0.75;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 420px;
}

.hm-detail-pane {
    flex-grow: 1;
    min-width: 200px;
    min-height: 80px;
    padding: 8px;
}

.hm-detail-placeholder {
    opacity: 0.6;
    -unity-text-align: middle-center;
    flex-grow: 1;
    justify-content: center;
}

.hm-detail-summary {
    white-space: normal;
}

.hm-statusbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 2px 8px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.25);
}

.hm-statusbar-text {
    opacity: 0.8;
}
