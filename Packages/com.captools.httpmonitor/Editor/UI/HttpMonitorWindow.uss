/* HTTP Monitor window. Layout colours resolve against the active Editor theme; status colours are
   fixed because they carry meaning (same hues as browser dev tools). */

.hm-root {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- toolbar */

.hm-toolbar {
    flex-shrink: 0;
}

.hm-toolbar-spacer {
    flex-grow: 1;
}

.hm-record-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 4px;
    margin-left: 2px;
    align-self: center;
    background-color: #d13438;
}

.hm-record-dot--paused {
    background-color: #8a8a8a;
}

/* ---------------------------------------------------------------- split */

.hm-split {
    flex-grow: 1;
}

.hm-list-pane {
    flex-grow: 1;
    min-width: 200px;
    min-height: 80px;
}

.hm-record-list {
    flex-grow: 1;
}

.hm-list {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- cells */

.hm-cell {
    padding-left: 4px;
    padding-right: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
    height: 100%;
}

.hm-cell-method {
    -unity-font-style: bold;
}

.hm-cell-status {
    -unity-text-align: middle-right;
}

.hm-cell-status--error {
    color: #f85149;
}

.hm-cell-right {
    -unity-text-align: middle-right;
}

.hm-cell-dot {
    align-items: center;
    justify-content: center;
    height: 100%;
}

.hm-cell-name {
    flex-direction: row;
    align-items: center;
}

.hm-cell-name-text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hm-cell-source {
    align-items: center;
    justify-content: center;
    height: 100%;
}

/* Source badges: three hues far apart on the wheel plus distinct glyphs, so they stay
   distinguishable under both themes and with red-green colour blindness. */
.hm-source-badge {
    font-size: 9px;
    -unity-font-style: bold;
    padding: 0 4px;
    border-radius: 3px;
    border-width: 1px;
    -unity-text-align: middle-center;
    min-width: 16px;
    height: 14px;
}

.hm-source-badge--automatic {
    background-color: rgba(63, 185, 80, 0.18);
    border-color: rgb(63, 185, 80);
    color: rgb(63, 185, 80);
}

.hm-source-badge--manual {
    background-color: rgba(88, 166, 255, 0.18);
    border-color: rgb(88, 166, 255);
    color: rgb(88, 166, 255);
}

.hm-source-badge--both {
    background-color: rgba(188, 140, 255, 0.18);
    border-color: rgb(188, 140, 255);
    color: rgb(188, 140, 255);
}

.hm-source-badge--unknown {
    border-color: rgba(128, 128, 128, 0.6);
    color: rgba(128, 128, 128, 0.9);
}

.hm-light .hm-source-badge--automatic { color: rgb(26, 127, 55); border-color: rgb(26, 127, 55); }
.hm-light .hm-source-badge--manual { color: rgb(9, 105, 218); border-color: rgb(9, 105, 218); }
.hm-light .hm-source-badge--both { color: rgb(130, 80, 223); border-color: rgb(130, 80, 223); }

/* ---------------------------------------------------------------- filter bar */

.hm-filterbar {
    flex-shrink: 0;
}

.hm-search {
    width: 260px;
    min-width: 120px;
    margin-right: 6px;
}

.hm-chip {
    padding-left: 6px;
    padding-right: 6px;
}

.hm-chip--errors:checked {
    color: rgb(248, 81, 73);
}

.hm-chip--automatic:checked {
    color: rgb(63, 185, 80);
}

.hm-chip--manual:checked {
    color: rgb(88, 166, 255);
}

.hm-filter-separator {
    width: 1px;
    height: 14px;
    margin: 0 4px;
    align-self: center;
    background-color: rgba(128, 128, 128, 0.35);
}

.hm-method-dropdown {
    width: 110px;
    margin: 0 4px;
}

.hm-method-dropdown > .unity-base-field__label {
    display: none;
}

.hm-host-chip {
    color: rgb(88, 166, 255);
}

/* ---------------------------------------------------------------- timeline */

.hm-timeline {
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.25);
    background-color: rgba(0, 0, 0, 0.08);
}

.hm-timeline-axis {
    position: absolute;
    left: 8px;
    bottom: 3px;
    font-size: 10px;
    opacity: 0.6;
}

.hm-timeline-tooltip {
    position: absolute;
    padding: 2px 6px;
    border-radius: 3px;
    background-color: rgba(30, 30, 30, 0.95);
    color: rgb(230, 230, 230);
    font-size: 10px;
}

.hm-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    flex-shrink: 0;
    background-color: #8a8a8a;
}

.hm-status-dot--pending {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: #8a8a8a;
}

.hm-status-dot--2xx { background-color: #3fb950; }
.hm-status-dot--3xx { background-color: #58a6ff; }
.hm-status-dot--4xx { background-color: #e3a008; }
.hm-status-dot--5xx { background-color: #f85149; }
.hm-status-dot--failed { background-color: #f85149; }
.hm-status-dot--aborted { background-color: #8a8a8a; }

/* ---------------------------------------------------------------- jump to latest */

.hm-jump-latest {
    position: absolute;
    right: 20px;
    bottom: 8px;
    padding: 3px 10px;
    border-radius: 10px;
    opacity: 0.92;
}

/* ---------------------------------------------------------------- empty state */

.hm-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.hm-empty-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.hm-empty-text {
    opacity: 0.75;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 420px;
}

/* ---------------------------------------------------------------- detail */

.hm-detail-pane {
    flex-grow: 1;
    min-width: 200px;
    min-height: 80px;
    padding: 8px;
}

.hm-detail-placeholder {
    opacity: 0.6;
    -unity-text-align: middle-center;
    flex-grow: 1;
    justify-content: center;
}

.hm-detail-summary {
    white-space: normal;
}

/* ---------------------------------------------------------------- status bar */

.hm-statusbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 2px 8px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.25);
}

.hm-statusbar-text {
    opacity: 0.8;
}
