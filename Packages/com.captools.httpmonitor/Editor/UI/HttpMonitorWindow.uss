/* HTTP Monitor window. Layout colours resolve against the active Editor theme; status colours are
   fixed because they carry meaning (same hues as browser dev tools). */

.hm-root {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- toolbar */

.hm-toolbar {
    flex-shrink: 0;
}

.hm-toolbar-spacer {
    flex-grow: 1;
}

.hm-record-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 4px;
    margin-left: 2px;
    align-self: center;
    background-color: #d13438;
}

.hm-record-dot--paused {
    background-color: #8a8a8a;
}

/* ---------------------------------------------------------------- split */

.hm-split {
    flex-grow: 1;
}

.hm-list-pane {
    flex-grow: 1;
    min-width: 200px;
    min-height: 80px;
}

.hm-record-list {
    flex-grow: 1;
}

.hm-list {
    flex-grow: 1;
}

/* ---------------------------------------------------------------- cells */

.hm-cell {
    padding-left: 4px;
    padding-right: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
    height: 100%;
}

.hm-cell-method {
    -unity-font-style: bold;
}

.hm-cell-status {
    -unity-text-align: middle-right;
}

.hm-cell-status--error {
    color: #f85149;
}

.hm-cell-right {
    -unity-text-align: middle-right;
}

.hm-cell-dot {
    align-items: center;
    justify-content: center;
    height: 100%;
}

.hm-cell-name {
    flex-direction: row;
    align-items: center;
}

.hm-cell-name-text {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hm-cell-source {
    align-items: center;
    justify-content: center;
    height: 100%;
}

/* Source badges: three hues far apart on the wheel plus distinct glyphs, so they stay
   distinguishable under both themes and with red-green colour blindness. */
.hm-source-badge {
    font-size: 9px;
    -unity-font-style: bold;
    padding: 0 4px;
    border-radius: 3px;
    border-width: 1px;
    -unity-text-align: middle-center;
    min-width: 16px;
    height: 14px;
}

.hm-source-badge--automatic {
    background-color: rgba(63, 185, 80, 0.18);
    border-color: rgb(63, 185, 80);
    color: rgb(63, 185, 80);
}

.hm-source-badge--manual {
    background-color: rgba(88, 166, 255, 0.18);
    border-color: rgb(88, 166, 255);
    color: rgb(88, 166, 255);
}

.hm-source-badge--both {
    background-color: rgba(188, 140, 255, 0.18);
    border-color: rgb(188, 140, 255);
    color: rgb(188, 140, 255);
}

.hm-source-badge--unknown {
    border-color: rgba(128, 128, 128, 0.6);
    color: rgba(128, 128, 128, 0.9);
}

.hm-source-badge--imported {
    background-color: rgba(227, 160, 8, 0.15);
    border-color: rgb(227, 160, 8);
    color: rgb(227, 160, 8);
    font-size: 8px;
}

.hm-light .hm-source-badge--automatic { color: rgb(26, 127, 55); border-color: rgb(26, 127, 55); }
.hm-light .hm-source-badge--manual { color: rgb(9, 105, 218); border-color: rgb(9, 105, 218); }
.hm-light .hm-source-badge--both { color: rgb(130, 80, 223); border-color: rgb(130, 80, 223); }

/* ---------------------------------------------------------------- filter bar */

.hm-filterbar {
    flex-shrink: 0;
}

.hm-search {
    width: 260px;
    min-width: 120px;
    margin-right: 6px;
}

.hm-chip {
    padding-left: 6px;
    padding-right: 6px;
}

.hm-chip--errors:checked {
    color: rgb(248, 81, 73);
}

.hm-chip--automatic:checked {
    color: rgb(63, 185, 80);
}

.hm-chip--manual:checked {
    color: rgb(88, 166, 255);
}

.hm-filter-separator {
    width: 1px;
    height: 14px;
    margin: 0 4px;
    align-self: center;
    background-color: rgba(128, 128, 128, 0.35);
}

.hm-method-dropdown {
    width: 110px;
    margin: 0 4px;
}

.hm-method-dropdown > .unity-base-field__label {
    display: none;
}

.hm-host-chip {
    color: rgb(88, 166, 255);
}

/* ---------------------------------------------------------------- timeline */

.hm-timeline {
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.25);
    background-color: rgba(0, 0, 0, 0.08);
}

.hm-timeline-handle {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 5px;
    cursor: resize-vertical;
}

.hm-timeline-handle:hover {
    background-color: rgba(88, 166, 255, 0.35);
}

.hm-timeline-axis {
    position: absolute;
    left: 8px;
    bottom: 3px;
    font-size: 10px;
    opacity: 0.6;
}

.hm-timeline--collapsed .hm-timeline-axis {
    top: 4px;
    opacity: 0.8;
}

.hm-timeline-collapse {
    position: absolute;
    right: 6px;
    bottom: 2px;
    font-size: 9px;
    padding: 0 6px;
    height: 16px;
    margin: 0;
    opacity: 0.7;
}

.hm-timeline-collapse:hover {
    opacity: 1;
}

.hm-timeline--collapsed .hm-timeline-collapse {
    top: 2px;
}

/* ---------------------------------------------------------------- maximized detail */

.hm-maximized {
    flex-grow: 1;
}

.hm-compact-strip {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 22px;
    padding: 0 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.25);
    background-color: rgba(0, 0, 0, 0.08);
}

.hm-compact-strip:hover {
    background-color: rgba(88, 166, 255, 0.12);
}

.hm-compact-strip > .hm-status-dot {
    margin-right: 6px;
}

.hm-compact-method {
    -unity-font-style: bold;
    margin-right: 8px;
}

.hm-compact-status {
    margin-right: 10px;
    min-width: 30px;
}

.hm-compact-name {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hm-compact-hint {
    opacity: 0.55;
    font-size: 10px;
    margin-left: 12px;
    flex-shrink: 0;
}

.hm-maximize {
    margin-left: 8px;
}

/* ---------------------------------------------------------------- project settings page */

.hm-settings {
    padding: 2px 20px 20px 10px;
}

.hm-settings-title {
    font-size: 19px;
    -unity-font-style: bold;
    margin: 8px 0 6px 0;
}

.hm-settings-location {
    opacity: 0.65;
    margin-bottom: 10px;
    cursor: link;
}

.hm-settings-location:hover {
    opacity: 1;
}

.hm-settings-section {
    margin-top: 12px;
    padding: 8px 10px 10px 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.25);
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.05);
}

.hm-settings-heading {
    -unity-font-style: bold;
    font-size: 13px;
    margin-bottom: 2px;
}

.hm-settings-note {
    opacity: 0.65;
    white-space: normal;
    margin-bottom: 6px;
}

.hm-settings-text {
    white-space: normal;
    margin-bottom: 8px;
}

.hm-settings-box {
    margin-top: 8px;
    padding: 12px;
    border-width: 1px;
    border-color: rgba(88, 166, 255, 0.5);
    border-radius: 3px;
    background-color: rgba(88, 166, 255, 0.08);
}

.hm-settings-button {
    align-self: flex-start;
    margin-top: 10px;
    padding: 3px 14px;
}

.hm-settings-banner {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin: 4px 0 8px 0;
    border-radius: 3px;
    background-color: rgba(227, 160, 8, 0.15);
    border-width: 1px;
    border-color: rgba(227, 160, 8, 0.7);
}

.hm-settings-banner-text {
    flex-grow: 1;
    white-space: normal;
}

/* ---------------------------------------------------------------- pop-out */

.hm-popped-out {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 16px;
}

.hm-popped-out-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.hm-popped-out-button {
    margin-top: 10px;
    padding: 3px 14px;
}

.hm-detail-window-summary {
    align-self: center;
    margin-left: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    flex-shrink: 1;
    opacity: 0.85;
}

.hm-timeline-tooltip {
    position: absolute;
    padding: 2px 6px;
    border-radius: 3px;
    background-color: rgba(30, 30, 30, 0.95);
    color: rgb(230, 230, 230);
    font-size: 10px;
}

.hm-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    flex-shrink: 0;
    background-color: #8a8a8a;
}

.hm-status-dot--pending {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: #8a8a8a;
}

.hm-status-dot--2xx { background-color: #3fb950; }
.hm-status-dot--3xx { background-color: #58a6ff; }
.hm-status-dot--4xx { background-color: #e3a008; }
.hm-status-dot--5xx { background-color: #f85149; }
.hm-status-dot--failed { background-color: #f85149; }
.hm-status-dot--aborted { background-color: #8a8a8a; }

/* ---------------------------------------------------------------- jump to latest */

.hm-jump-latest {
    position: absolute;
    right: 20px;
    bottom: 8px;
    padding: 3px 10px;
    border-radius: 10px;
    opacity: 0.92;
}

/* ---------------------------------------------------------------- empty state */

.hm-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 24px;
}

.hm-empty-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    -unity-text-align: middle-center;
}

.hm-empty-text {
    opacity: 0.75;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 420px;
}

/* ---------------------------------------------------------------- detail */

.hm-detail-pane {
    flex-grow: 1;
    min-width: 200px;
    min-height: 80px;
}

.hm-detail-placeholder {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 16px;
}

.hm-detail-content {
    flex-grow: 1;
}

.hm-muted {
    opacity: 0.6;
    white-space: normal;
    -unity-text-align: middle-center;
}

.hm-small-button {
    font-size: 10px;
    padding: 1px 6px;
    margin: 0 0 0 4px;
    height: 18px;
}

/* summary strip */

.hm-summary {
    padding: 8px 10px 6px 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.25);
}

.hm-summary-line {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.hm-summary-method {
    -unity-font-style: bold;
    font-size: 13px;
    margin-right: 8px;
    flex-shrink: 0;
}

.hm-summary-url {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 6px;
}

.hm-summary-status {
    -unity-font-style: bold;
    margin-right: 10px;
    flex-shrink: 0;
}

.hm-status-text--2xx { color: #3fb950; }
.hm-status-text--3xx { color: #58a6ff; }
.hm-status-text--4xx { color: #e3a008; }
.hm-status-text--5xx { color: #f85149; }
.hm-status-text--failed { color: #f85149; }
.hm-status-text--aborted { color: #8a8a8a; }
.hm-status-text--pending { color: #8a8a8a; }

.hm-summary-meta {
    opacity: 0.75;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.hm-summary-error {
    color: #f85149;
    white-space: normal;
    margin-top: 2px;
}

/* request / response blocks */

.hm-block {
    margin: 6px 6px 0 6px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.3);
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.06);
    min-height: 120px;
}

.hm-block-head {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.25);
    background-color: rgba(0, 0, 0, 0.08);
}

.hm-block-title {
    -unity-font-style: bold;
    margin-right: 10px;
    min-width: 64px;
}

.hm-tab {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    margin: 0 2px;
    padding: 2px 8px;
    opacity: 0.7;
}

.hm-tab:hover {
    opacity: 1;
}

.hm-tab--active {
    opacity: 1;
    border-bottom-color: #58a6ff;
}

.hm-block-caption {
    opacity: 0.8;
    -unity-font-style: bold;
}

.hm-block-caption--error {
    color: #f85149;
    opacity: 1;
}

/* headers */

.hm-headers {
    padding: 4px 6px 6px 6px;
}

.hm-headers-bar {
    flex-direction: row;
    justify-content: flex-end;
    margin-bottom: 2px;
}

.hm-header-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 2px 4px;
    border-radius: 2px;
}

.hm-header-row:hover {
    background-color: rgba(128, 128, 128, 0.12);
}

.hm-header-name {
    width: 34%;
    min-width: 90px;
    max-width: 260px;
    -unity-font-style: bold;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin-right: 8px;
}

.hm-header-value {
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
}

.hm-redacted-badge {
    font-size: 9px;
    padding: 0 5px;
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(227, 160, 8, 0.8);
    color: rgb(227, 160, 8);
    align-self: flex-start;
}

/* body */

.hm-body {
    flex-grow: 1;
    padding: 4px 6px 6px 6px;
}

.hm-body-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.hm-body-banner {
    opacity: 0.7;
    font-size: 10px;
    white-space: normal;
    flex-shrink: 1;
}

.hm-body-banner--warn {
    opacity: 1;
    color: rgb(227, 160, 8);
}

.hm-body-modes {
    flex-direction: row;
    margin-right: 6px;
}

.hm-mode {
    font-size: 10px;
    padding: 1px 7px;
    margin: 0;
    height: 18px;
    border-radius: 0;
    opacity: 0.7;
}

.hm-mode:hover {
    opacity: 1;
}

.hm-mode--active {
    opacity: 1;
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: #58a6ff;
}

.hm-body-wrap {
    margin: 0 6px 0 0;
    font-size: 10px;
}

.hm-body-wrap > .unity-toggle__input {
    flex-direction: row-reverse;
}

.hm-body-scroll {
    max-height: 420px;
    background-color: rgba(0, 0, 0, 0.15);
    border-radius: 2px;
}

.hm-light .hm-body-scroll {
    background-color: rgba(255, 255, 255, 0.5);
}

.hm-body-text-row {
    flex-direction: row;
    align-items: flex-start;
}

.hm-body-lines {
    padding: 4px 6px 4px 8px;
    white-space: pre;
    -unity-text-align: upper-right;
    opacity: 0.45;
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.3);
    flex-shrink: 0;
}

.hm-body-text {
    padding: 4px 6px;
    white-space: pre;
    flex-shrink: 1;
}

.hm-body-image {
    margin: 8px;
}

.hm-body-note {
    padding: 4px 6px;
    font-size: 10px;
    color: rgb(227, 160, 8);
    white-space: normal;
}

/* ---------------------------------------------------------------- status bar */

.hm-statusbar {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding: 2px 8px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.25);
}

.hm-statusbar-text {
    opacity: 0.8;
}
